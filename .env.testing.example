# ==============================================================================
# ERE — Dedicated PostgreSQL Testing Environment Template
# ==============================================================================
# Instructions for Local Native PostgreSQL Execution:
# 1. Open pgAdmin 4 (connected using your existing saved connection).
# 2. Right-click the server or "postgres" database -> "Query Tool".
# 3. Execute the following idempotent role creation script:
#
#    DO $do$
#    BEGIN
#       IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = 'ere_test') THEN
#          CREATE ROLE ere_test WITH LOGIN PASSWORD 'your_secure_test_password' CREATEDB;
#       ELSE
#          ALTER ROLE ere_test WITH LOGIN PASSWORD 'your_secure_test_password' CREATEDB;
#       END IF;
#    END $do$;
#
# 4. If the database 'ere_testing' does not already exist, create it:
#
#    CREATE DATABASE ere_testing WITH OWNER = ere_test ENCODING = 'UTF8';
#    GRANT ALL PRIVILEGES ON DATABASE ere_testing TO ere_test;
#
# 5. Copy this file to .env.testing (which is strictly ignored by Git):
#    Copy-Item .env.testing.example .env.testing
#
# 6. Set DB_PG_PASSWORD below to 'your_secure_test_password'.
# 7. Run the dedicated native PostgreSQL suite:
#    php artisan test tests/Feature/PostgresPaymentConcurrencyTest.php
# ==============================================================================

APP_ENV=testing
APP_KEY=base64:V9SAL7dweH7BNKRqlFgAt4SDztSbtM5I8SRVcp0KvLE=
APP_DEBUG=true

# Dedicated PostgreSQL Testing Database Configuration
DB_CONNECTION=sqlite
DB_PG_HOST=127.0.0.1
DB_PG_PORT=5432
DB_PG_DATABASE=ere_testing
DB_PG_USERNAME=ere_test
DB_PG_PASSWORD=
DB_PG_SSLMODE=prefer

# Standard Driver Defaults for Testing
BCRYPT_ROUNDS=4
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
BROADCAST_CONNECTION=null
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
